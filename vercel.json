{
  "crons": [
    {
      "path": "/api/mfp-sync",
      "schedule": "0 2 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/wanderer",
      "destination": "/wanderer/index.html"
    },
    {
      "source": "/wanderer/(.*)",
      "destination": "/wanderer/$1"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
