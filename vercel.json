{
  "functions": {
    "api/mfp-sync.js": {
      "maxDuration": 30
    },
    "api/daily.js": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/mfp-sync",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/daily?ns=reminders&action=sweep",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/daily?ns=reminders&action=send-telegram",
      "schedule": "0,30 * * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/wanderer",
      "destination": "/wanderer/index.html"
    },
    {
      "source": "/wanderer/(.*)",
      "destination": "/wanderer/$1"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
